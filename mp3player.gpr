project Mp3player is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src", "c");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("plasma_player.adb");

   package Compiler is
      for Driver ("C") use "gcc";
      for Default_Switches ("Ada") use ("-O2", "-gnat2022");
      for Default_Switches ("C") use ("-O2", "-Wall", "-Wextra", "-std=c11");
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-lSDL2", "-lmpg123", "-lm");
   end Linker;
end Mp3player;
